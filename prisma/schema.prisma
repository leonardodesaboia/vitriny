generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Soft delete: a conta é anonimizada, mas o histórico de pedidos e
  // propostas permanece para a futura tela administrativa.
  deletedAt        DateTime?
  // SHA-256 do e-mail original: detecta recorrência (ex.: excluir e recriar
  // conta para zerar limites) sem armazenar o dado pessoal.
  deletedEmailHash String?

  providerProfile        ProviderProfile?
  accounts               Account[]
  sessions               Session[]
  internalNotes          QuoteRequestInternalNote[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationToken EmailVerificationToken?

  @@index([deletedEmailHash])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  slug         String   @unique
  businessName String
  description  String?
  phone        String?
  email        String?
  city         String?
  state        String?
  plan         PlanTier @default(FREE)
  themePreset  ProviderThemePreset @default(DEFAULT)
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  stripePriceId        String?
  subscriptionStatus   SubscriptionStatus?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean             @default(false)
  pixKey        String?
  pixKeyType    String?
  pixHolderName String?
  pixCity       String?
  businessType BusinessType @default(SERVICES)
  address       String?
  instagram     String?
  facebook      String?
  tiktok        String?
  // Horário de funcionamento: array JSON de 7 posições (0 = domingo),
  // cada uma { open, close } em "HH:MM" ou null (fechado). Validado por Zod
  // na escrita e por parseBusinessHours na leitura.
  businessHours Json?
  // Links livres do perfil: array JSON de { label, url }. Validado e cortado
  // em MAX_PROFILE_LINKS por lib/profile-links.ts na escrita e na leitura.
  links Json?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services          Service[]
  quoteRequests     QuoteRequest[]
  proposals         Proposal[]
  proposalTemplates ProposalTemplate[]
}

model Service {
  id                        String             @id @default(cuid())
  providerId                String
  name                      String
  description               String?
  itemType                  CatalogItemType          @default(SERVICE)
  basePrice                 Decimal?           @db.Decimal(10, 2)
  isActive                  Boolean            @default(true)
  pricingType               ServicePricingType       @default(CUSTOM)
  fixedServiceCheckoutMode  FixedServiceCheckoutMode @default(REQUEST_ONLY)
  // Campos do formulário público, independentes entre si:
  // requiresSchedulingDetails = data + horário; requiresLocation = local.
  requiresSchedulingDetails Boolean                  @default(false)
  requiresLocation          Boolean                  @default(false)
  imageUrl                  String?
  imageStorageKey           String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  quoteRequests QuoteRequest[]
}

model QuoteRequest {
  id            String             @id @default(cuid())
  providerId    String
  serviceId     String?
  customerName  String
  customerEmail String?
  customerPhone String?
  description   String?
  desiredDate               String?
  desiredTime               String?
  location                  String?
  status                    QuoteRequestStatus @default(NEW)
  // Snapshot do nome do item na criação: preserva o histórico mesmo se o
  // item for renomeado ou excluído (serviceId vira null via SetNull).
  serviceNameSnapshot       String?
  fixedServiceAmount        Decimal?           @db.Decimal(10, 2)
  pixReservationRequestedAt DateTime?
  pixReservationPaidAt      DateTime?
  // Sinal do cliente ("Já fiz o pagamento"); a confirmação continua manual
  // pelo negócio via pixReservationPaidAt.
  pixReservationClientPaidAt DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  provider      ProviderProfile             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service       Service?                    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  proposal      Proposal?
  statusHistory QuoteRequestStatusHistory[]
  internalNotes QuoteRequestInternalNote[]

  @@index([serviceId])
}

model QuoteRequestInternalNote {
  id             String   @id @default(cuid())
  quoteRequestId String
  authorUserId   String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
  @@index([authorUserId])
}

model QuoteRequestStatusHistory {
  id             String                  @id @default(cuid())
  quoteRequestId String
  fromStatus     QuoteRequestStatus?
  toStatus       QuoteRequestStatus
  actor          QuoteRequestStatusActor
  note           String?
  createdAt      DateTime                @default(now())

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
  @@index([createdAt])
}

model Proposal {
  id             String                @id @default(cuid())
  providerId     String
  quoteRequestId String                @unique
  publicToken    String                @unique @default(uuid())
  pricingMode    ProposalPricingMode   @default(SIMPLE)
  title          String?
  description    String?
  totalAmount    Decimal               @db.Decimal(10, 2)
  status         ProposalStatus        @default(DRAFT)
  validUntil     DateTime?
  respondedAt    DateTime?
  depositAmount  Decimal?       @db.Decimal(10, 2)
  depositPaidAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  provider      ProviderProfile         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  quoteRequest  QuoteRequest            @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  items         ProposalItem[]
  statusHistory ProposalStatusHistory[]
}

model ProposalStatusHistory {
  id         String                  @id @default(cuid())
  proposalId String
  fromStatus ProposalStatus?
  toStatus   ProposalStatus
  actor      QuoteRequestStatusActor
  note       String?
  createdAt  DateTime                @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([createdAt])
}

model ProposalTemplate {
  id          String   @id @default(cuid())
  providerId  String
  name        String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider ProviderProfile        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  items    ProposalTemplateItem[]

  @@index([providerId])
}

model ProposalTemplateItem {
  id          String   @id @default(cuid())
  templateId  String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template ProposalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model ProposalItem {
  id          String   @id @default(cuid())
  proposalId  String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

enum QuoteRequestStatus {
  NEW
  REVIEWING
  PROPOSAL_SENT
  CLOSED
}

enum QuoteRequestStatusActor {
  CUSTOMER
  PROVIDER
  SYSTEM
}

enum ProposalStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum ProposalPricingMode {
  SIMPLE
  ITEMIZED
}

enum BusinessType {
  PRODUCTS
  SERVICES
  BOTH
}

enum PlanTier {
  FREE
  PRO
}

enum ProviderThemePreset {
  DEFAULT
  CLEAN
  BEAUTY
  CREATIVE
  PREMIUM
  BOLD
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum ServicePricingType {
  FIXED
  CUSTOM
}

enum CatalogItemType {
  SERVICE
  PRODUCT
}

enum FixedServiceCheckoutMode {
  REQUEST_ONLY
  REQUIRE_PIX_PAYMENT
}
