# App Next.js (front + back). Caddy resolve o TLS via Let's Encrypt automaticamente.
{$DOMAIN} {
	encode zstd gzip

	# HSTS (foi deixado de fora do next.config pra configurar aqui, no proxy).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	reverse_proxy app:3000
}

# CDN público das imagens do bucket MinIO.
# S3_PUBLIC_BASE_URL deve ser https://SEU-CDN_DOMAIN/vitriny
{$CDN_DOMAIN} {
	encode zstd gzip
	header Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy minio:9000
}
