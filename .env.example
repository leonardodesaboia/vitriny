# Banco de dados
DATABASE_URL="postgresql://vitriny:vitriny@localhost:5432/vitriny"

# Auth.js
AUTH_SECRET="gere-um-segredo-com-openssl-rand-base64-33"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID="seu-google-client-id"
AUTH_GOOGLE_SECRET="seu-google-client-secret"

# Resend (confirmação de cadastro, redefinição de senha e notificações)
RESEND_API_KEY="re_sua_api_key"
EMAIL_FROM="Vitriny <contato@seu-dominio.com>"

# Mercado Pago
MP_ACCESS_TOKEN="APP_USR-..."
MP_WEBHOOK_SECRET="..."
MP_PRO_AMOUNT="19.90"
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."
# Opcional: init_point do preapproval_plan com Pix habilitado (payment_methods_allowed).
# Só configurar depois que o Mercado Pago liberar Pix Automático pra Assinaturas
# nesta conta — ver docs/MERCADO_PAGO.md. Ausente = botão de Pix continua oculto.
MP_PRO_PLAN_INIT_POINT=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fuso horário do processo. Limites mensais e expiração de proposta usam a
# meia-noite do Brasil; instrumentation.ts já aplica este padrão, defina aqui
# apenas para sobrescrever (ex.: em plataformas que rodam em UTC).
TZ="America/Sao_Paulo"

# MinIO / Storage (compatível com S3)
# S3_ENDPOINT: endpoint usado pelo SDK para enviar arquivos (interno)
# S3_PUBLIC_BASE_URL: URL pública usada para construir imageUrl (externo / browser)
# Se o bucket não estiver público, o upload funciona mas a imagem não aparece no browser.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="seu-access-key-id"
S3_SECRET_ACCESS_KEY="seu-secret-access-key"
S3_BUCKET_NAME="vitriny"
S3_PUBLIC_BASE_URL="http://localhost:9000/vitriny"
S3_FORCE_PATH_STYLE="true"
